# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Also load-bearing for paid games: api/create-payment.ts builds ToyyibPay's
# billReturnUrl/billCallbackUrl from this, and api/toyyibpay-callback.ts uses it
# to fetch the game's .html file to attach to the delivery email. Must be set to
# the real production domain (not left as a placeholder) for paid games to work.
APP_URL="MY_APP_URL"

# --- ToyyibPay (paid games) ---
# TOYYIBPAY_SECRET_KEY: your ToyyibPay "User Secret Key" from Settings -> API Key.
# Server-side only, used by api/create-payment.ts, api/verify-payment.ts, and
# api/toyyibpay-callback.ts to create bills and re-verify payment status.
TOYYIBPAY_SECRET_KEY="MY_TOYYIBPAY_SECRET_KEY"

# TOYYIBPAY_CATEGORY_CODE: the ToyyibPay "Category" code that paid Bambli games'
# bills are created under (Category = a folder for grouping related bills).
TOYYIBPAY_CATEGORY_CODE="MY_TOYYIBPAY_CATEGORY_CODE"

# TOYYIBPAY_BASE_URL: https://dev.toyyibpay.com for sandbox testing,
# https://toyyibpay.com in production. Flipping only this var goes live.
TOYYIBPAY_BASE_URL="https://dev.toyyibpay.com"

# BREVO_SENDER_EMAIL / BREVO_SENDER_NAME: the verified sender (Brevo -> Senders
# & IP -> Senders) used by api/toyyibpay-callback.ts to email buyers their paid
# game file. Separate from the contacts-list API usage in api/subscribe.ts.
BREVO_SENDER_EMAIL="hello@bambli.online"
BREVO_SENDER_NAME="Bambli Games"

# BREVO_API_KEY: Brevo (Sendinblue) API v3 key, used by api/subscribe.ts to add
# newsletter signups (footer form + parent-gate modal) to a Brevo contact list.
# Create one at Brevo -> Settings -> SMTP & API -> API Keys. Server-side only,
# never exposed to the browser. Set this in Vercel's Environment Variables.
BREVO_API_KEY="MY_BREVO_API_KEY"

# BREVO_LIST_ID: numeric ID of the Brevo contact list to add subscribers to.
# Find it at Brevo -> Contacts -> Lists (click a list to see its ID in the URL).
BREVO_LIST_ID="MY_BREVO_LIST_ID"

# NOTION_API_KEY: Internal integration secret from notion.so/my-integrations,
# used by api/subscribe.ts to also log signups into the "Kids Games Newsletter
# Contacts" database. The integration must be shared ("Connections") with that
# database in Notion, or writes will fail with an "object not found" error.
NOTION_API_KEY="MY_NOTION_API_KEY"
